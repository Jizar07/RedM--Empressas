# Development environment configuration

# Frontend API URL (used by browser)
NEXT_PUBLIC_API_URL=http://localhost:3050/api

# Server-side API URL (used by Next.js server)
API_URL=http://localhost:3050/api

# Bot authentication token for API calls to backend
# NEXT_PUBLIC_BOT_WEBHOOK_TOKEN=your_token_here

# NextAuth URL for OAuth redirects (set to your domain when accessing remotely)
NEXTAUTH_URL=https://fazenda.stoffeltech.com